{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiscoMod",
  "version": "1.0.2",
  "identifier": "com.thororen.discomod",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DiscoMod - A Dead as Disco Mod Manager",
        "width": 1100,
        "height": 860,
        "minWidth": 900,
        "minHeight": 700,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: http:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' asset: https: http:; media-src 'self' asset: https://asset.localhost http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "bin/ffmpeg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0OTg5MUM3MzdGMDA1MEIKUldRTEJmQTN4NUdZVlBCYjdNM0FxMmpCY0x4RWVlckcvY1l1bVd1TWNVUjlheUFlTFdKbDNIZ1EK",
      "endpoints": [
        "https://github.com/thororen1234/DiscoMod/releases/latest/download/latest.json"
      ]
    }
  }
}